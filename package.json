{
  "name": "spirit-stones-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "sprites": "node scripts/process-sprites.mjs",
    "prebuild:test": "npx esbuild src/test/launch-prologue.ts --outfile=src/test/launch-prologue.js --platform=node --target=es2020"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "esbuild": "^0.27.7",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  }
}
